{
  "manifest_version": 3,
  "name": "Text Explain — 划词解释（dsh-text-explain）",
  "version": "0.2.0",
  "description": "划中网页上任何一段看不懂的话，本地 DeepSeek Harness 用大白话讲给你听。三档讲法，与 DSH 里的划词解释同一套后端。",
  "key": "",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:3080/*",
    "http://localhost:3080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "markdown.js",
        "styles.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Text Explain：点此打开设置"
  }
}
